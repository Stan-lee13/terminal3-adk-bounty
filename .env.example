# Terminal3 ADK Bounty — Environment Variables

# Required: Your Terminal3 API key from https://www.terminal3.io/claim-page
# This key is shown ONLY ONCE. Copy it immediately.
T3N_API_KEY=

# Optional: Expected DID for verification (shown on the claim page)
T3N_EXPECTED_DID=

# Optional: Duffel API key for the reference flight-booking contract
# Get one at https://developers.duffel.com/
DUFFEL_API_KEY=
